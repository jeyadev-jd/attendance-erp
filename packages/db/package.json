{
  "name": "@attendance/db",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "//exports": "Subpaths keep the Supabase transport importable without pulling in the Prisma/D1 barrel. At final cutover the '.' entry goes away with Prisma; these stay.",
  "exports": {
    ".": "./src/index.ts",
    "./supabase": "./src/supabase.ts",
    "./queries": "./src/queries.ts",
    "./repos/*": "./src/repos/*.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^5.22.0",
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.112.2",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
